{
  "manifest_version": 3,
  "name": "Internal Windows UA Switcher",
  "version": "1.0.0",
  "description": "Spoof Windows User-Agent and Platform headers/JS for QC testing on Linux",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
