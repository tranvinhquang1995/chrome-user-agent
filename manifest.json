{
  "manifest_version": 3,
  "name": "Internal OS UA Switcher",
  "version": "1.1.0",
  "description": "Switch between Windows spoof and full-header Linux mode for QC testing",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OS UA Switcher"
  },
  "background": {
    "service_worker": "background.js"
  }
}
